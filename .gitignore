# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node / UI
node_modules/
ui/dist/
# Written by scripts/dev/warm_worktree.py: which node_modules dirs in this
# worktree are links to the main checkout (per-worktree, never committed)
.warm-worktree.json

# Playwright E2E output (reports, traces, per-run artifacts)
ui/playwright-report/
ui/test-results/
ui/blob-report/

# Tauri
desktop/src-tauri/target/
# Generated by tauri-build on every run (capability schemas, plugin manifests)
desktop/src-tauri/gen/

# Local config & secrets — never commit
.env
workbench.toml
*.local.json
# Per-user workspace data (shortcuts.md and anything else Workbench keeps here)
.workbench/

# OS noise
Thumbs.db
.DS_Store
