# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node / UI
node_modules/
ui/dist/

# Playwright E2E output (reports, traces, per-run artifacts)
ui/playwright-report/
ui/test-results/
ui/blob-report/
# Perf lane output — its own folders so a perf run never overwrites a journey run
ui/playwright-report-perf/
ui/perf-results/

# Tauri
desktop/src-tauri/target/
# Generated by tauri-build on every run (capability schemas, plugin manifests)
desktop/src-tauri/gen/

# Local config & secrets — never commit
.env
workbench.toml
*.local.json
# Per-user workspace data (shortcuts.md and anything else Workbench keeps here)
.workbench/

# Local agent tooling: the PR pipeline script and the worktrees lanes run in.
# Machine-specific by nature (absolute paths, a local gh location), so it is
# never committed — see the danger-zone rule in CLAUDE.md.
.claude/

# OS noise
Thumbs.db
.DS_Store
